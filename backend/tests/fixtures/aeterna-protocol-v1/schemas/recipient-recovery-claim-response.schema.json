{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:recipient-recovery-claim-response",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "claim_token": {
          "$ref": "common.schema.json#/$defs/base64url32"
        },
        "device_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "recovery_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "scope": {
          "const": "recovery.recipient.rotate",
          "type": "string"
        },
        "vault_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "wrapper_digest": {
          "$ref": "common.schema.json#/$defs/base64url32"
        }
      },
      "required": [
        "account_id",
        "claim_token",
        "device_id",
        "expires_at",
        "recovery_id",
        "scope",
        "vault_id",
        "wrapper_digest"
      ],
      "type": "object"
    }
  },
  "required": ["data", "protocol_version", "request_id"],
  "type": "object"
}
