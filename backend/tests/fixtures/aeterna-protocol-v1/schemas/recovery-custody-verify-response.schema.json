{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:recovery-custody-verify-response",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "verified": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": ["verified"],
      "type": "object"
    }
  },
  "required": ["data", "protocol_version", "request_id"],
  "type": "object"
}
