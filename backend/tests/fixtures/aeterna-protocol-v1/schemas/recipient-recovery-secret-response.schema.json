{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:recipient-recovery-secret-response",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "device_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "vault_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "recovery_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "wrapper_digest": {
          "$ref": "common.schema.json#/$defs/base64url32"
        },
        "policy_epoch": {
          "minimum": 1,
          "type": "integer"
        },
        "recovery_generation": {
          "minimum": 1,
          "type": "integer"
        },
        "rekey_required": {
          "const": true,
          "type": "boolean"
        },
        "srs": {
          "$ref": "common.schema.json#/$defs/base64url32"
        },
        "rotation_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "state": {
          "const": "reserved",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "device_id",
        "policy_epoch",
        "recovery_generation",
        "recovery_id",
        "rekey_required",
        "rotation_id",
        "srs",
        "state",
        "vault_id",
        "wrapper_digest"
      ],
      "type": "object"
    }
  },
  "required": ["data", "protocol_version", "request_id"],
  "type": "object"
}
