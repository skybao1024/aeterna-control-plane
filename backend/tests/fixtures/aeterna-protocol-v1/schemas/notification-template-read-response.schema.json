{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:notification-template-read-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 1,
      "type": "integer"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "field": {
          "type": "string",
          "enum": ["owner_message", "contact_message"]
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "message": {
          "type": "string",
          "maxLength": 4096,
          "x-aeterna-max-utf8-bytes": 4096,
          "x-aeterna-normalization": "NFC",
          "x-aeterna-controls": "Only newline and tab are permitted."
        }
      },
      "required": ["account_id", "field", "version", "message"]
    }
  },
  "required": ["protocol_version", "request_id", "data"]
}
