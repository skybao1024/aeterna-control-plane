{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:trigger-test-warning-challenge-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "view": {
          "$ref": "trigger-test-view.schema.json"
        },
        "challenge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "expiresAt": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "resendAfterSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            }
          },
          "required": ["id", "expiresAt", "resendAfterSeconds"]
        }
      },
      "required": ["view", "challenge"]
    }
  },
  "required": ["protocol_version", "request_id", "data"]
}
