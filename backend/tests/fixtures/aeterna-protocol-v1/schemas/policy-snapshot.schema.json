{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:policy-snapshot",
  "additionalProperties": false,
  "properties": {
    "epoch": { "minimum": 1, "type": "integer" },
    "generation": { "minimum": 1, "type": "integer" },
    "state": {
      "enum": [
        "ACTIVE",
        "PRE_WARNING",
        "GRACE_PERIOD",
        "RELEASED",
        "DISABLED",
        "DELETED"
      ],
      "type": "string"
    },
    "inactivity_days": { "minimum": 14, "maximum": 365, "type": "integer" },
    "warning_days": { "minimum": 3, "maximum": 30, "type": "integer" },
    "grace_days": { "minimum": 3, "maximum": 24855, "type": "integer" },
    "due_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "version": { "minimum": 0, "type": "integer" }
  },
  "required": [
    "epoch",
    "generation",
    "state",
    "inactivity_days",
    "warning_days",
    "grace_days",
    "due_at",
    "version"
  ],
  "type": "object",
  "x-aeterna-constraint": "warning_days < inactivity_days"
}
