{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:trigger-test-release-secret-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "view": {
          "$ref": "trigger-test-view.schema.json"
        },
        "source_srs": {
          "$ref": "common.schema.json#/$defs/base64url32"
        },
        "target_recovery_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "target_srs": {
          "$ref": "common.schema.json#/$defs/base64url32"
        }
      },
      "required": ["view", "source_srs", "target_recovery_id", "target_srs"]
    }
  },
  "required": ["protocol_version", "request_id", "data"]
}
