{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:recovery-custody-challenge-response",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "challenge_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "challenge": {
          "$ref": "common.schema.json#/$defs/base64url32"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "required": ["challenge_id", "challenge", "expires_at"],
      "type": "object"
    }
  },
  "required": ["data", "protocol_version", "request_id"],
  "type": "object"
}
