{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeterna:protocol:v1:trigger-test-activate-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "$ref": "common.schema.json#/$defs/protocolVersion"
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonicalization": {
          "$ref": "common.schema.json#/$defs/canonicalization"
        },
        "domain": {
          "type": "string",
          "const": "aeterna.trigger-test.activate.v1"
        },
        "operation": {
          "type": "string",
          "const": "trigger_test.activate"
        },
        "protocol_version": {
          "$ref": "common.schema.json#/$defs/protocolVersion"
        },
        "signature_version": {
          "$ref": "common.schema.json#/$defs/signatureVersion"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "account_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "device_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "session_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "sample_vault_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_recovery_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "wrapper_digest": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/base64url32"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "canonicalization",
        "domain",
        "operation",
        "protocol_version",
        "signature_version",
        "request_id",
        "account_id",
        "device_id",
        "session_id",
        "sample_vault_id",
        "source_recovery_id",
        "wrapper_digest"
      ]
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/base64url64"
    }
  },
  "required": ["protocol_version", "signed", "signature"]
}
