# Project
COMPOSE_PROJECT_NAME=aeterna-control-plane
PROJECT_NAME=Aeterna Control Plane
ENV=development
BIND_ADDRESS=127.0.0.1

# Container images
PYTHON_IMAGE=python:3.14.5-slim
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
NPM_REGISTRY=https://registry.npmjs.org
IMAGE_TAG=local

# Frontend
FRONTEND_DEV_PORT=3000
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:3000
# Public recipient origin used by the production Compose profile for email links.
AETERNA_PUBLIC_FRONTEND_URL=https://claim.aeternarelay.com
VITE_API_BASE_URL=/api

# Backend
API_V1_STR=/api/v1
API_PORT=8001

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=development-postgres-password
POSTGRES_DB=app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5436
POSTGRES_SSL_REQUIRE=false

# AI development database access (non-secret MCP controls)
POSTGRES_MCP_ROLE=ai_mcp_reader
POSTGRES_MCP_ALLOWED_SCHEMAS=public
POSTGRES_MCP_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_MCP_STATEMENT_TIMEOUT_MS=5000
POSTGRES_MCP_LOCK_TIMEOUT_MS=1000

# Redis and Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6386
REDIS_PASSWORD=development-redis-password
CELERY_LOG_LEVEL=info

# Authentication
# Replace this value before using the production profile.
SECRET_KEY=replace-this-development-secret-before-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Aeterna identity keys (development and test only)
# Generate three distinct 32-byte base64url values without padding. Production
# and preview reject all three values; use a persisted KMS envelope instead.
AETERNA_PII_KEY_V1=
AETERNA_LOOKUP_KEY_V1=
AETERNA_OTP_KEY_V1=

# Production/preview identity. Provision the ciphertext envelope exactly once
# through the identity-setup Compose profile. Never regenerate for an existing
# database or put AWS credentials here. Shared KMS keys require explicit opt-in
# and purpose-scoped IAM policies; application data keys remain independent.
AETERNA_KMS_ALLOW_SHARED_KEY=false
AETERNA_IDENTITY_KEY_PROVIDER=environment
AETERNA_IDENTITY_KMS_ENABLED=false
AETERNA_IDENTITY_KMS_REGION=ap-southeast-1
AETERNA_IDENTITY_KMS_KEY_ARN=
AETERNA_IDENTITY_KMS_ENVELOPE_PATH=/app/identity-keys/envelope.json

# Optional docker-compose.aws.yml (non-EC2 hosts): external SDK profile directory.
# Use temporary credentials or credential_process; do not put credential values
# in this file. This directory must be readable by the container's app user.
AWS_CONFIG_DIRECTORY=
AETERNA_AWS_PROFILE=aeterna-runtime

# Email (optional; SMTP is restricted to a local development sink)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Aeterna Relay
MAIL_ENCRYPTION=tls
# Retained legacy fields; application mail does not use Brevo.
BREVO_API_KEY=
BREVO_EMAIL_FROM=noreply@example.com
BREVO_EMAIL_FROM_NAME=Aeterna Relay

# Unified application email. AWS credentials are not accepted here; use an
# IAM task/instance role or the standard AWS credential provider chain. Keep the
# enable flag false until the SES Region, sender identity, configuration set,
# SNS topic, and operating jurisdictions are approved and provisioned.
AETERNA_EMAIL_PROVIDER=aws-ses
AETERNA_EMAIL_PRODUCTION_ENABLED=false
AWS_SES_REGION=
AWS_SES_FROM_ADDRESS=
AWS_SES_CONFIGURATION_SET=
AWS_SES_SNS_TOPIC_ARN=
# Temporary operator setup: cache signed confirmation material for 15 minutes.
# This never confirms a subscription automatically or enables outbound mail.
AWS_SES_SNS_CONFIRMATION_CAPTURE_ENABLED=false

# Aeterna I13 recovery SRS envelope. The approved production design uses one
# customer-managed symmetric single-Region key in Singapore. No AWS credential
# value belongs here; use the standard IAM role/credential provider chain.
AETERNA_RECOVERY_KEY_PROVIDER=disabled
AETERNA_RECOVERY_KMS_ENABLED=false
AETERNA_RECOVERY_KMS_REGION=ap-southeast-1
AETERNA_RECOVERY_KMS_KEY_ARN=
# Development/test only: canonical unpadded base64url of 32 synthetic bytes.
# Never commit a populated value or use this provider in preview/production.
AETERNA_RECOVERY_LOCAL_TEST_KEY=
ADMIN_EMAIL=admin@example.com

# Application defaults
USE_HTTP_PROXY=false
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_EXPIRE_SECONDS=300
VERIFICATION_CODE_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Optional Celery monitoring
FLOWER_USER=admin
FLOWER_PASSWORD=change-this-flower-password
FLOWER_PORT=5556
